# The SEARCH-ONLY key served to every visitor. Public by construction, but not
# committed: the deployed copy is synthesized on the runner from the
# DEMO_CONFIG_JS repository variable. Any config.js at any depth.
config.js
public/shared/config.js

# The WRITE key that scripts/ use to build the index and the agents. Maintainer's
# machine only — never a browser, never a build, never CI. See .env.example.
.env
.env.local

# Built by scripts/build-passages.js from the committed texts — derived, not source.
passages.jsonl

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Cloudflare / wrangler
.wrangler/
node_modules/

# Built by tools/main-demo-provision.mjs against one backend — local state, not source.
public/main-demo/variants.json
